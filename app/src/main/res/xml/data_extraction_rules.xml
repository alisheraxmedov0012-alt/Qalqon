<?xml version="1.0" encoding="utf-8"?>
<!--
  Stage 4 / privacy: QALQON's local data must never leave the device through a
  backup or a device-to-device transfer.

  `android:allowBackup="false"` still stops Google Drive cloud backups, but since
  Android 12 that attribute only governs *cloud* backups — it no longer covers
  device-to-device (D2D) transfers, which are configured here instead. Without
  these rules a phone-to-phone transfer could copy the app-private database,
  including the encrypted face-template ciphertext, to another device.

  Every domain is excluded from both a cloud backup and a device transfer, so the
  only copy of QALQON's data is the one on the device that created it. The face
  templates are additionally AES-GCM-encrypted with a key held in the Android
  Keystore, and that key is device-bound and never included in any transfer — so
  even a ciphertext copy would be undecryptable elsewhere.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
